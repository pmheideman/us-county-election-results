# Raw downloads and third-party packages: large, and not ours to redistribute
# (R/data/* not R/data/ -- a directory-level ignore can't be un-ignored per-file by git)
R/data/*
# ...except hand-maintained metadata that the release pipeline depends on (small, not a download)
!R/data/source_registry.csv
!R/data/house_unopposed_no_ballot.csv
119372-V1/
119372-V1.zip
micro2020.csv
*.pdf
# R / editor / tool state
.Rproj.user/
.Rhistory
.RData
.claude/
# Secrets: IPUMS API key
.Renviron
# Large derived intermediates (released via GitHub Releases instead)
R/output/**/*.rds
!R/output/elect_cty_final_provenance_summary.csv
# Stray/orphaned build artifacts, not referenced by any current script
R/output/elect_cty_final
R/output/test.rds

# Release files (published via GitHub Releases, not committed)
release/**/*.csv

# Shiny app: derived .rds data (rebuild via shiny_app/data_prep/prepare_data.R) and raw tigris shapefile cache
shiny_app/data/

# Python bytecode
__pycache__/
